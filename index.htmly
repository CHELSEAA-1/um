	MinWidth = 220,
	MaxWidth = 460,
	MinHeight = 200,
	MaxHeight = 640,
	DefaultWidth = 270,
	DefaultHeight = 398,
	TopBarHeight = 48,
	MinScale = 0.75,
	MaxScale = 1.45,
}

