ResizeHandle.Position = UDim2.new(1, -20, 1, -20)
ResizeHandle.BackgroundTransparency = 1
ResizeHandle.Text = "◢"
ResizeHandle.TextColor3 = Color3.fromRGB(214, 66, 36)
ResizeHandle.TextSize = 13
ResizeHandle.Font = Enum.Font.GothamBold
ResizeHandle.AutoButtonColor = false
ResizeHandle.Visible = true
ResizeHandle.Parent = MainFrame

local function createSwitchRow(name, baseLabel, yPos, onChanged)
	local row = Instance.new("Frame")
	row.Name = name .. "Row"
	row.Size = UDim2.new(1, -12, 0, 52)
	row.Position = UDim2.fromOffset(6, yPos)
	row.BackgroundTransparency = 1
	row.Visible = true
	row.Parent = BodyFrame

	local label = Instance.new("TextLabel")
	label.Name = "Label"
	label.Size = UDim2.new(1, -76, 1, 0)
	label.Position = UDim2.fromOffset(0, 0)
	label.BackgroundTransparency = 1
	label.Text = baseLabel .. " OFF"
	label.TextColor3 = Color3.fromRGB(238, 240, 245)
	label.TextSize = 13
	label.Font = Enum.Font.GothamBold
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.TextTruncate = Enum.TextTruncate.AtEnd
	label.Visible = true
	label.Parent = row

	local track = Instance.new("TextButton")
	track.Name = "SwitchTrack"
	track.Size = UDim2.fromOffset(64, 32)
	track.Position = UDim2.new(1, -64, 0.5, -16)
	track.BackgroundColor3 = Color3.fromRGB(48, 49, 58)
	track.BorderSizePixel = 0
	track.Text = ""
	track.AutoButtonColor = false
	track.Visible = true
	track.Parent = row

	local trackCorner = Instance.new("UICorner")
	trackCorner.CornerRadius = UDim.new(1, 0)
	trackCorner.Parent = track

	local knob = Instance.new("Frame")
	knob.Name = "Knob"
	knob.Size = UDim2.fromOffset(24, 24)
	knob.Position = UDim2.fromOffset(4, 4)
	knob.BackgroundColor3 = Color3.fromRGB(255, 255, 255)
	knob.BorderSizePixel = 0
	knob.Visible = true
	knob.Parent = track

	local knobCorner = Instance.new("UICorner")
	knobCorner.CornerRadius = UDim.new(1, 0)
	knobCorner.Parent = knob

	local active = false

	local function setVisualState(isOn, instant)
		active = isOn
		label.Text = string.format("%s %s", baseLabel, isOn and "ON" or "OFF")

		local targetTrackColor = isOn and Color3.fromRGB(36, 150, 88) or Color3.fromRGB(48, 49, 58)
		local targetKnobPos = isOn and UDim2.fromOffset(36, 4) or UDim2.fromOffset(4, 4)

		if instant then
			track.BackgroundColor3 = targetTrackColor
			knob.Position = targetKnobPos
		else
			TweenService:Create(track, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				BackgroundColor3 = targetTrackColor,
			}):Play()
			TweenService:Create(knob, TweenInfo.new(0.14, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
				Position = targetKnobPos,
			}):Play()
		end
	end

	setVisualState(false, true)

	track.MouseButton1Click:Connect(function()
		setVisualState(not active, false)
		onChanged(active)
	end)

	return {
		SetState = function(v)
			setVisualState(v, false)
		end,
	}
end

local autoSwitch
local equipSwitch
local trainSwitch
local upgradePlotSwitch
local upgradeTrainingSwitch
local x2BoostSwitch

autoSwitch = createSwitchRow("Auto", "AUTO", 2, function(state)
	CONFIG.AutoFarm = state
	if state then
		if CONFIG.AutoTrain then
			CONFIG.AutoTrain = false
			trainSwitch.SetState(false)
		end
		invalidateThrowCache()
		local target = resolveThrowTarget(true)
		local cf = getNodeCFrame(target, cachedThrowPart)
		if cf then
			teleportToCFrame(cf, CONFIG.TeleportOffset, true)
		end
		task.defer(function()
			if CONFIG.AutoFarm and running then
				fireThrowStep(os.clock(), true)
			end
		end)
	else
		restoreCharacterMovement()
	end
end)

equipSwitch = createSwitchRow("EquipBest", "EQUIP BEST", 60, function(state)
	CONFIG.EquipBestLoop = state
	if state then
		fireEquipBest()
	end
end)

trainSwitch = createSwitchRow("AutoTrain", "AUTO TRAIN", 118, function(state)
	CONFIG.AutoTrain = state
	if state then
		if CONFIG.AutoFarm then
			CONFIG.AutoFarm = false
			autoSwitch.SetState(false)
		end
		invalidateTrainCache()
		local spot = resolveTrainTarget(true)
		local cf = getNodeCFrame(spot, cachedTrainPart)
		if cf then
			teleportToCFrame(cf, CONFIG.TrainOffset, true)
		end
	else
		restoreCharacterMovement()
	end
end)

upgradePlotSwitch = createSwitchRow("UpgradePlot", "UPGRADE PLOT", 176, function(state)
	CONFIG.UpgradePlotLoop = state
	if state then
		fireUpgradePlot()
	end
end)

upgradeTrainingSwitch = createSwitchRow("UpgradeTraining", "UPGRADE TRAINING", 234, function(state)
	CONFIG.UpgradeTrainingLoop = state
	if state then
		cachedUpgradeTargets = scanUpgradeTargets()
		fireUpgradeTraining()
		task.defer(clickUpgradeButtonNow)
	else
		cachedUpgradeTargets = nil
		restoreCharacterMovement()
	end
end)

x2BoostSwitch = createSwitchRow("X2Boost", "X2 BOOST", 292, function(state)
	CONFIG.X2BoostLoop = state
	if state then
		fireX2Boost()
	end
end)

-- Smooth Dragging via TopBar
local dragging = false
local dragInput = nil
local dragStart = nil
local startPos = nil

TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		dragging = true
		dragStart = input.Position
		startPos = MainFrame.Position

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				dragging = false
			end
		end)
	end
end)

TopBar.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		dragInput = input
	end
end)

-- Corner Resize Handle
local resizing = false
local resizeInput = nil
local resizeStart = nil
local startSize = nil

ResizeHandle.InputBegan:Connect(function(input)
	if minimized then
		return
	end
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		resizing = true
		resizeStart = input.Position
		startSize = MainFrame.Size

		input.Changed:Connect(function()
			if input.UserInputState == Enum.UserInputState.End then
				resizing = false
			end
		end)
	end
end)

ResizeHandle.InputChanged:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		resizeInput = input
	end
end)

local inputChangedConn = UserInputService.InputChanged:Connect(function(input)
	if dragging and input == dragInput and dragStart and startPos then
		local delta = input.Position - dragStart
		MainFrame.Position = UDim2.new(
			startPos.X.Scale,
			startPos.X.Offset + delta.X,
			startPos.Y.Scale,
			startPos.Y.Offset + delta.Y
		)
	elseif resizing and input == resizeInput and resizeStart and startSize and not minimized then
		local delta = (input.Position - resizeStart) / currentScale
		local newW = math.clamp(math.floor(startSize.X.Offset + delta.X + 0.5), UI_LIMITS.MinWidth, UI_LIMITS.MaxWidth)
		local newH = math.clamp(math.floor(startSize.Y.Offset + delta.Y + 0.5), UI_LIMITS.MinHeight, UI_LIMITS.MaxHeight)
		expandedSize = UDim2.fromOffset(newW, newH)
		MainFrame.Size = expandedSize
	end
end)

local function setMinimizedState(isMin)
	minimized = isMin
	MainFrame.Visible = not minimized
	MiniPill.Visible = minimized
	MiniPill.Position = UDim2.new(0.5, -96, 0, 10)
	MinimizeBtn.Text = minimized and "+" or "-"
end

MinimizeBtn.MouseButton1Click:Connect(function()
	setMinimizedState(true)
end)

MiniPill.MouseButton1Click:Connect(function()
	setMinimizedState(false)
end)

MainFrame.Visible = true
MiniPill.Visible = false
ScreenGui.Enabled = true

-- Resolve remotes in background so UI never blocks
task.spawn(function()
	local sharedFolder = ReplicatedStorage:FindFirstChild("Shared") or ReplicatedStorage:WaitForChild("Shared", 10)
	local remotes = sharedFolder and (sharedFolder:FindFirstChild("Remotes") or sharedFolder:WaitForChild("Remotes", 10))
	if remotes then
		ThrowRemote = remotes:FindFirstChild("Throw") or remotes:WaitForChild("Throw", 10)
		MonsterRemote = remotes:FindFirstChild("Monster") or remotes:WaitForChild("Monster", 10)
		PlotRemote = remotes:FindFirstChild("Plot") or remotes:WaitForChild("Plot", 10)
		GoRemote = remotes:FindFirstChild("Go") or remotes:WaitForChild("Go", 10)
		StandRemote = remotes:FindFirstChild("Stand") or remotes:WaitForChild("Stand", 10)
	end
end)

local heartbeatConn
CloseBtn.MouseButton1Click:Connect(function()
	running = false
	CONFIG.AutoFarm = false
	CONFIG.EquipBestLoop = false
	CONFIG.AutoTrain = false
	CONFIG.UpgradePlotLoop = false
	CONFIG.UpgradeTrainingLoop = false
	CONFIG.X2BoostLoop = false
	invalidateThrowCache()
	invalidateTrainCache()
	cachedUpgradeTargets = nil
	restoreCharacterMovement()
	if inputChangedConn then
		inputChangedConn:Disconnect()
		inputChangedConn = nil
	end
	if heartbeatConn then
		heartbeatConn:Disconnect()
		heartbeatConn = nil
	end
	ScreenGui:Destroy()
end)

local lastTap = 0
local lastSkip = 0
local lastPrompt = 0
local lastTpCheck = 0
local lastEquip = 0
local lastUpgradePlot = 0
local lastUpgradeTraining = 0
local lastX2Boost = 0

heartbeatConn = RunService.Heartbeat:Connect(function()
	if not running then
		return
	end

	local now = os.clock()

	if minimized and MiniPill.Visible then
		MiniPill.Position = UDim2.new(0.5, -96, 0, 10)
		for i = 1, #visualizerBars do
			local entry = visualizerBars[i]
			local wave = (math.sin(now * 8 + entry.Phase) + 1) * 0.5
			local h = math.floor(5 + wave * 15)
			entry.Frame.Size = UDim2.fromOffset(barWidth, h)
			entry.Frame.Position = UDim2.new(0, (i - 1) * (barWidth + barGap), 0.5, -math.floor(h * 0.5))
		end
	end

	if CONFIG.EquipBestLoop and now - lastEquip >= CONFIG.EquipBestInterval then
		lastEquip = now
		fireEquipBest()
	end

	if CONFIG.UpgradePlotLoop and now - lastUpgradePlot >= CONFIG.UpgradePlotInterval then
		lastUpgradePlot = now
		fireUpgradePlot()
	end

	if CONFIG.UpgradeTrainingLoop and now - lastUpgradeTraining >= CONFIG.UpgradeTrainingInterval then
		lastUpgradeTraining = now
		fireUpgradeTraining()
	end

	if CONFIG.X2BoostLoop and now - lastX2Boost >= CONFIG.X2BoostInterval then
		lastX2Boost = now
		fireX2Boost()
	end

	if CONFIG.AutoFarm then
		local target = resolveThrowTarget(false)
		local targetCf = target and getNodeCFrame(target, cachedThrowPart)

		if targetCf and now - lastTpCheck >= CONFIG.TeleportCheckInterval then
			lastTpCheck = now
			teleportToCFrame(targetCf, CONFIG.TeleportOffset, false)
		end

		if target and now - lastPrompt >= CONFIG.PulseInterval then
			lastPrompt = now
			pulseCached(cachedThrowPrompts, cachedThrowClicks, cachedThrowPart)
		end

		if now - lastTap >= CONFIG.TapInterval then
			lastTap = now
			local shouldSkip = (now - lastSkip) >= CONFIG.SkipInterval
			if shouldSkip then
				lastSkip = now
			end
			fireThrowStep(now, shouldSkip)
		end
	end
end)