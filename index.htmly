local function makeTopButton(name, text, xOffset, textSize)
	local btn = Instance.new("TextButton")
	btn.Name = name
	btn.Size = UDim2.fromOffset(30, 28)
	btn.Position = UDim2.new(1, xOffset, 0.5, -14)
	btn.BackgroundColor3 = Color3.fromRGB(34, 34, 40)
	btn.BorderSizePixel = 0
	btn.Text = text
	btn.TextColor3 = Color3.fromRGB(238, 240, 245)
	btn.TextSize = textSize
	btn.Font = Enum.Font.GothamBold
	btn.Visible = true
	btn.Parent = TopBar

	local corner = Instance.new("UICorner")
	corner.CornerRadius = UDim.new(0, 7)
	corner.Parent = btn

	return btn
end

