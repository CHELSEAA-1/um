local ThrowRemote = nil
local MonsterRemote = nil
local PlotRemote = nil
local GoRemote = nil
local StandRemote = nil

local cachedThrowTarget = nil
local cachedThrowPart = nil
local cachedThrowPrompts = nil
local cachedThrowClicks = nil
local lastThrowCacheTime = 0

local cachedTrainTarget = nil
local cachedTrainPart = nil
local cachedTrainPrompts = nil
local cachedTrainClicks = nil
local lastTrainCacheTime = 0

local cachedUpgradeTargets = nil

local savedWalkSpeed = nil
local savedJumpPower = nil
local savedJumpHeight = nil
local savedUseJumpPower = nil

local function getUiParent()
	local candidates = {}

	if typeof(gethui) == "function" then
		local ok, res = pcall(gethui)
		if ok and typeof(res) == "Instance" then
			table.insert(candidates, res)
		end
	end

	table.insert(candidates, CoreGui)

	if LocalPlayer then
		local playerGui = LocalPlayer:FindFirstChildOfClass("PlayerGui") or LocalPlayer:WaitForChild("PlayerGui", 5)
		if playerGui then
			table.insert(candidates, playerGui)
		end
	end

	for _, parentObj in ipairs(candidates) do
		local ok = pcall(function()
			local probe = Instance.new("Folder")
			probe.Name = "__UiProbe"
			probe.Parent = parentObj
			probe:Destroy()
		end)
		if ok then
			return parentObj
		end
	end

	return LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui") or CoreGui
end

local function invalidateThrowCache()
	cachedThrowTarget = nil
	cachedThrowPart = nil
	cachedThrowPrompts = nil
	cachedThrowClicks = nil
	lastThrowCacheTime = 0
end

local function invalidateTrainCache()
	cachedTrainTarget = nil
	cachedTrainPart = nil
	cachedTrainPrompts = nil
	cachedTrainClicks = nil
	lastTrainCacheTime = 0
end

local function getRootPart()
	local char = LocalPlayer and LocalPlayer.Character
	if not char or not char.Parent then
		return nil, nil
	end
	local hum = char:FindFirstChildOfClass("Humanoid")
	local hrp = char:FindFirstChild("HumanoidRootPart")
	if not hrp or not hrp:IsA("BasePart") then
		return nil, hum
	end
	return hrp, hum
end

local function captureCharacterDefaults(humanoid)
	if not humanoid then
		return
	end
	if not savedWalkSpeed then
		savedWalkSpeed = humanoid.WalkSpeed > 0 and humanoid.WalkSpeed or 16
	end
	if humanoid.UseJumpPower then
		savedUseJumpPower = true
		if not savedJumpPower then
			savedJumpPower = humanoid.JumpPower > 0 and humanoid.JumpPower or 50
		end
	else
		savedUseJumpPower = false
		if not savedJumpHeight then
			savedJumpHeight = humanoid.JumpHeight > 0 and humanoid.JumpHeight or 7.2
		end
	end
end

local function restoreCharacterMovement()
	local hrp, humanoid = getRootPart()
	if hrp then
		pcall(function()
			hrp.Anchored = false
			hrp.AssemblyLinearVelocity = Vector3.zero
			hrp.AssemblyAngularVelocity = Vector3.zero
		end)
	end

	if humanoid then
		pcall(function()
			humanoid.PlatformStand = false
			humanoid.Sit = false
			if savedWalkSpeed and humanoid.WalkSpeed <= 0 then
				humanoid.WalkSpeed = savedWalkSpeed
			end
			if savedUseJumpPower and savedJumpPower and humanoid.JumpPower <= 0 then
				humanoid.JumpPower = savedJumpPower
			elseif not savedUseJumpPower and savedJumpHeight and humanoid.JumpHeight <= 0 then
				humanoid.JumpHeight = savedJumpHeight
			end
		end)
	end
end

if LocalPlayer then
	LocalPlayer.CharacterAdded:Connect(function(char)
		savedWalkSpeed = nil
		savedJumpPower = nil
		savedJumpHeight = nil
		savedUseJumpPower = nil
		invalidateThrowCache()
		invalidateTrainCache()
		local hum = char:WaitForChild("Humanoid", 5)
		captureCharacterDefaults(hum)
	end)
	if LocalPlayer.Character then
		captureCharacterDefaults(LocalPlayer.Character:FindFirstChildOfClass("Humanoid"))
	end
end

local function collectInteractables(root)
	local prompts = {}
	local clicks = {}
	if not root then
		return prompts, clicks
	end
	for _, desc in ipairs(root:GetDescendants()) do
		if desc:IsA("ProximityPrompt") then
			pcall(function()
				desc.MaxActivationDistance = math.max(desc.MaxActivationDistance, 1e6)
			end)
			table.insert(prompts, desc)
		elseif desc:IsA("ClickDetector") then
			table.insert(clicks, desc)
		end
	end
	return prompts, clicks
end

local function findPrimaryPart(node)
	if not node then
		return nil
	end
	if node:IsA("BasePart") then
		return node
	end
	if node:IsA("Model") then
		if node.PrimaryPart and node.PrimaryPart:IsA("BasePart") then
			return node.PrimaryPart
		end
	end
	return node:FindFirstChildWhichIsA("BasePart", true)
end

local function resolveThrowTarget(forceRefresh)
	local now = os.clock()
	if not forceRefresh and cachedThrowTarget and cachedThrowTarget.Parent and (now - lastThrowCacheTime) < CONFIG.CacheRefreshInterval then
		if cachedThrowPart and cachedThrowPart.Parent then
			return cachedThrowTarget
		end
	end

	local map = workspace:FindFirstChild("Map")
	local base = map and map:FindFirstChild("Base")
	local throwFolder = base and base:FindFirstChild("Throw")
	if not throwFolder then
		invalidateThrowCache()
		return nil
	end

	local children = throwFolder:GetChildren()
	local node = children[CONFIG.ThrowChildIndex]
	if not node then
		for _, candidate in ipairs(children) do
			if findPrimaryPart(candidate) then
				node = candidate
				break
			end
		end
	end

	if not node then
		invalidateThrowCache()
		return nil
	end

	local part = findPrimaryPart(node)
	if not part then
		invalidateThrowCache()
		return nil
	end

	local root = node:IsA("BasePart") and node or (node.Parent and node.Parent:IsA("Model") and node.Parent or node)
	cachedThrowTarget = node
	cachedThrowPart = part
	cachedThrowPrompts, cachedThrowClicks = collectInteractables(root)
	lastThrowCacheTime = now

	return node
end

local function resolveTrainTarget(forceRefresh)
	local now = os.clock()
	if not forceRefresh and cachedTrainTarget and cachedTrainTarget.Parent and (now - lastTrainCacheTime) < CONFIG.CacheRefreshInterval then
		if cachedTrainPart and cachedTrainPart.Parent then
			return cachedTrainTarget
		end
	end

	local map = workspace:FindFirstChild("Map")
	local base = map and map:FindFirstChild("Base")
	local plots = base and base:FindFirstChild("Plots")
	local plot4 = plots and plots:FindFirstChild("Plot4")
	local trainingSpot = plot4 and plot4:FindFirstChild("TrainingSpot")
	local standSpot = trainingSpot and trainingSpot:FindFirstChild("StandSpot")
	if not standSpot then
		invalidateTrainCache()
		return nil
	end

	local part = findPrimaryPart(standSpot)
	if not part then
		invalidateTrainCache()
		return nil
	end

	local root = standSpot:IsA("BasePart") and standSpot or (standSpot.Parent and standSpot.Parent:IsA("Model") and standSpot.Parent or standSpot)
	cachedTrainTarget = standSpot
	cachedTrainPart = part
	cachedTrainPrompts, cachedTrainClicks = collectInteractables(root)
	lastTrainCacheTime = now

	return standSpot
end

local function clickGuiElement(btn)
	if not btn or not btn.Parent then
		return false
	end

	local clicked = false

	pcall(function()
		btn:Activate()
		clicked = true
	end)

	if typeof(firesignal) == "function" then
		pcall(function()
			firesignal(btn.MouseButton1Click)
			clicked = true
		end)
		pcall(function()
			firesignal(btn.MouseButton1Down)
			firesignal(btn.MouseButton1Up)
			firesignal(btn.Activated)
			clicked = true
		end)
	end

	return clicked
end

local function scanUpgradeTargets()
	local found = {}
	local containers = {}

	local playerGui = LocalPlayer and LocalPlayer:FindFirstChildOfClass("PlayerGui")
	if playerGui then
		table.insert(containers, playerGui)
	end
	if typeof(gethui) == "function" then
		local ok, h = pcall(gethui)
		if ok and typeof(h) == "Instance" then
			table.insert(containers, h)
		end
	end
	table.insert(containers, CoreGui)

	for _, container in ipairs(containers) do
		for _, desc in ipairs(container:GetDescendants()) do
			if desc:IsA("GuiButton") and desc.Visible then
				local matched = false
				if desc:IsA("TextButton") and string.find(string.lower(desc.Text), "upgrade", 1, true) then
					matched = true
				else
					for _, sub in ipairs(desc:GetDescendants()) do
						if sub:IsA("TextLabel") and string.find(string.lower(sub.Text), "upgrade", 1, true) then
							matched = true
							break
						end
					end
				end
				if matched then
					table.insert(found, desc)
				end
			end
		end
	end

	local map = workspace:FindFirstChild("Map")
	local base = map and map:FindFirstChild("Base")
	local plots = base and base:FindFirstChild("Plots")
	local plot4 = plots and plots:FindFirstChild("Plot4")
	local trainingSpot = plot4 and plot4:FindFirstChild("TrainingSpot")
	if trainingSpot then
		for _, desc in ipairs(trainingSpot:GetDescendants()) do
			if desc:IsA("ProximityPrompt") then
				pcall(function()
					desc.MaxActivationDistance = math.max(desc.MaxActivationDistance, 1e6)
				end)
				table.insert(found, desc)
			elseif desc:IsA("ClickDetector") then
				table.insert(found, desc)
			elseif desc:IsA("GuiButton") and desc.Visible then
				table.insert(found, desc)
			end
		end
	end

	return found
end

local function clickUpgradeButtonNow()
	if not running or not CONFIG.UpgradeTrainingLoop then
		return
	end

	if not cachedUpgradeTargets or #cachedUpgradeTargets == 0 then
		cachedUpgradeTargets = scanUpgradeTargets()
	end

	local anyClicked = false
	for i = 1, #cachedUpgradeTargets do
		local item = cachedUpgradeTargets[i]
		if item and item.Parent then
			if item:IsA("GuiButton") then
				if clickGuiElement(item) then
					anyClicked = true
				end
			elseif item:IsA("ProximityPrompt") and typeof(fireproximityprompt) == "function" then
				pcall(fireproximityprompt, item)
				anyClicked = true
			elseif item:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
				pcall(fireclickdetector, item)
				anyClicked = true
			end
		end
	end

	if not anyClicked then
		cachedUpgradeTargets = scanUpgradeTargets()
		for i = 1, #cachedUpgradeTargets do
			local item = cachedUpgradeTargets[i]
			if item and item.Parent then
				if item:IsA("GuiButton") then
					clickGuiElement(item)
				elseif item:IsA("ProximityPrompt") and typeof(fireproximityprompt) == "function" then
					pcall(fireproximityprompt, item)
				elseif item:IsA("ClickDetector") and typeof(fireclickdetector) == "function" then
					pcall(fireclickdetector, item)
				end
			end
		end
	end
end

local function getNodeCFrame(node, partCache)
	if partCache and partCache.Parent then
		return partCache.CFrame
	end
	if not node or not node.Parent then
		return nil
	end
	if node:IsA("BasePart") then
		return node.CFrame
	end
	if node:IsA("Model") then
		local ok, cf = pcall(function()
			return node:GetPivot()
		end)
		if ok and typeof(cf) == "CFrame" then
			return cf
		end
	end
	local part = findPrimaryPart(node)
	return part and part.CFrame or nil
end

local function getStandingPosition(basePos, offset)
	local off = offset or Vector3.new(0, 2.4, 0)
	local standHeight = math.clamp(off.Y, 2.0, 2.8)

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignoreList = {}
	if LocalPlayer and LocalPlayer.Character then
		table.insert(ignoreList, LocalPlayer.Character)
	end
	params.FilterDescendantsInstances = ignoreList

	local rayOrigin = Vector3.new(basePos.X, basePos.Y + 12, basePos.Z)
	local rayResult = workspace:Raycast(rayOrigin, Vector3.new(0, -40, 0), params)
	if rayResult then
		local groundY = rayResult.Position.Y
		return Vector3.new(basePos.X + off.X, groundY + standHeight, basePos.Z + off.Z)
	end

	return Vector3.new(basePos.X + off.X, basePos.Y + standHeight, basePos.Z + off.Z)
end

local function teleportToCFrame(cf, offset, force)
	if typeof(cf) ~= "CFrame" then
		return
	end

	local hrp, hum = getRootPart()
	if not hrp then
		return
	end

	if hum then
		pcall(function()
			if hum.Sit then
				hum.Sit = false
			end
			if hum.PlatformStand then
				hum.PlatformStand = false
			end
		end)
	end

	local dest = getStandingPosition(cf.Position, offset)
	local horizontalDist = (Vector3.new(hrp.Position.X, 0, hrp.Position.Z) - Vector3.new(dest.X, 0, dest.Z)).Magnitude
	local belowGround = hrp.Position.Y < (dest.Y - 2.6)

	if not force and horizontalDist <= CONFIG.DriftThreshold and not belowGround then
		return
	end

	pcall(function()
		hrp.Anchored = false
		hrp.AssemblyLinearVelocity = Vector3.zero
		hrp.AssemblyAngularVelocity = Vector3.zero
		hrp.CFrame = CFrame.new(dest)
	end)
end

local function pulseCached(prompts, clicks, part)
	if prompts and typeof(fireproximityprompt) == "function" then
		for i = 1, #prompts do
			local p = prompts[i]
			if p and p.Parent then
				pcall(fireproximityprompt, p)
			end
		end
	end

	if clicks and typeof(fireclickdetector) == "function" then
		for i = 1, #clicks do
			local c = clicks[i]
			if c and c.Parent then
				pcall(fireclickdetector, c)
			end
		end
	end

	local hrp = select(1, getRootPart())
	if hrp and part and part.Parent and typeof(firetouchinterest) == "function" then
		pcall(function()
			firetouchinterest(hrp, part, 0)
			firetouchinterest(hrp, part, 1)
		end)
	end
end

local function fireRemoteSafe(remote, ...)
	if not remote or not remote.Parent or not remote:IsA("RemoteEvent") then
		return false
	end
	local args = { ... }
	local ok = pcall(function()
		remote:FireServer(table.unpack(args))
	end)
	return ok
end

local function fireEquipBest()
	fireRemoteSafe(MonsterRemote, "EquipBest")
end

local function fireUpgradePlot()
	fireRemoteSafe(PlotRemote, "Upgrade")
end

local function fireUpgradeTraining()
	if not CONFIG.UpgradeTrainingLoop then
		return
	end
	fireRemoteSafe(GoRemote, "Training")
	clickUpgradeButtonNow()
end

local function fireX2Boost()
	if not CONFIG.X2BoostLoop then
		return
	end
	fireRemoteSafe(StandRemote, "Boost")
end

local function fireThrowStep(now, shouldSkip)
	if not ThrowRemote or not ThrowRemote.Parent then
		local sharedFolder = ReplicatedStorage:FindFirstChild("Shared")
		local remotes = sharedFolder and sharedFolder:FindFirstChild("Remotes")
		if remotes then
			ThrowRemote = remotes:FindFirstChild("Throw")
		end
	end

	if not ThrowRemote or not ThrowRemote:IsA("RemoteEvent") then
		return
	end

	local stamp = CONFIG.UseServerClock and workspace:GetServerTimeNow() or tick()
	for _ = 1, CONFIG.TapsPerStep do
		pcall(function()
			ThrowRemote:FireServer("Tap", stamp)
		end)
	end

	if shouldSkip then
		pcall(function()
			ThrowRemote:FireServer("Skip")
		end)
	end
end

