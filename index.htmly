local LocalPlayer = Players.LocalPlayer

local CONFIG = {
	AutoFarm = false,
	EquipBestLoop = false,
	AutoTrain = false,
	UpgradePlotLoop = false,
	UpgradeTrainingLoop = false,
	X2BoostLoop = false,
	TapsPerStep = 4,
	TapInterval = 0.04,
	SkipInterval = 0.06,
	PulseInterval = 0.12,
	EquipBestInterval = 0.5,
	UpgradePlotInterval = 0.5,
	UpgradeTrainingInterval = 0.25,
	X2BoostInterval = 0.25,
	TeleportCheckInterval = 0.4,
	CacheRefreshInterval = 1.0,
	DriftThreshold = 6.5,
	UseServerClock = true,
	ThrowChildIndex = 14,
	TeleportOffset = Vector3.new(0, 2.4, 0),
	TrainOffset = Vector3.new(0, 2.4, 0),
}

